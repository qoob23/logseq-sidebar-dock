{
  "name": "logseq-sidebar-dock",
  "version": "0.1.0",
  "description": "Logseq plugin that turns the left sidebar into nav + a dock pane hosting two selectable plugin views",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix"
  },
  "logseq": {
    "id": "logseq-sidebar-dock",
    "title": "Sidebar Dock",
    "main": "dist/index.html"
  },
  "dependencies": {
    "@logseq/libs": "^0.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
